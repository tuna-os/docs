{
  // This file is not used in compilation. It is here just for a nice editor experience.
  // Options are inlined from @docusaurus/tsconfig because TS 7 removed `baseUrl`
  // (TS5102), which that config still sets. `paths` resolves relative to this file.
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true
  },
  "exclude": [".docusaurus", "build"]
}
